# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RAPIDAPI_KEY: RapidAPI authentication key for TikTok Downloader API.
# Get your API key from https://rapidapi.com/atupal2116/api/tiktok-video-downloader-no-watermark1
# Sign up for a free account, subscribe to the API, and copy your key from the API dashboard.
# Required for downloading TikTok videos without watermark.
VITE_RAPIDAPI_KEY="your_rapidapi_key_here"

# VITE_RAPIDAPI_HOST: RapidAPI host header for TikTok Downloader API.
# This value should remain constant for the TikTok Video Downloader No Watermark API.
# Do not change this unless switching to a different RapidAPI endpoint.
VITE_RAPIDAPI_HOST="tiktok-video-downloader-no-watermark.p.rapidapi.com"
